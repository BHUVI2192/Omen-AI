generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  TPO_ADMIN
}
enum ProjectStatus {
  DRAFT
  SUBMITTED
  NEEDS_REWORK
  VERIFIED
}
enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  NOT_SHORTLISTED
  REJECTED
}
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}
enum CourseProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
enum BootcampSource {
  DEMAND
  OUTCOME
}
enum BootcampStatus {
  DRAFT
  OPEN
  CLOSED
}
enum NotificationType {
  OPPORTUNITY
  APPLICATION_CHANGE
  SHORTLIST
  INTERVIEW
  COURSE_RECOMMENDATION
  BOOTCAMP
  PROJECT_REVIEW
  ASSESSMENT_RESULT
}
enum AssessmentQuestionType {
  MCQ
  FILL_BLANK
}

model Profile {
  id          String         @id @default(uuid()) @db.Uuid
  authUserId  String         @unique @db.Uuid
  email       String         @unique
  fullName    String
  role        UserRole       @default(STUDENT)
  avatarPath  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     StudentProfile?
  tpo         TpoProfile?
  notifications Notification[]
  notificationPreference NotificationPreference?
  applications Application[]
  enrollments BootcampEnrollment[]
  courseProgress CourseProgress[]
  assessmentAttempts AssessmentAttempt[]
  projects Project[]
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  code      String   @unique
  students  StudentProfile[]
  cohorts   Cohort[]
  createdAt DateTime @default(now())
}

model Cohort {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  graduationYear Int
  departmentId   String   @db.Uuid
  department     Department @relation(fields: [departmentId], references: [id])
  students       StudentProfile[]
  createdAt      DateTime @default(now())
  @@unique([name, graduationYear, departmentId])
}

model StudentProfile {
  id              String   @id @default(uuid()) @db.Uuid
  profileId       String   @unique @db.Uuid
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  studentId       String   @unique
  departmentId    String?  @db.Uuid
  department      Department? @relation(fields: [departmentId], references: [id])
  cohortId        String?  @db.Uuid
  cohort          Cohort?  @relation(fields: [cohortId], references: [id])
  branch          String?
  semester        Int?
  tenthPercentage Decimal? @db.Decimal(5,2)
  twelfthPercentage Decimal? @db.Decimal(5,2)
  cgpa            Decimal? @db.Decimal(4,2)
  backlogs        Int      @default(0)
  careerInterests Json?
  readinessScore  Int      @default(0)
  scoreVersion    String   @default("2026.1")
  verifiedAt      DateTime?
  skills          StudentSkill[]
  certifications  Certification[]
  projects       Project[]
  internships    Internship[]
  hackathons     Hackathon[]
  resumes        Resume[]
  roleMatches    CareerRoleMatch[]
  jobMatches     StudentJobMatch[]
  skillGaps      SkillGap[]
  placementResults PlacementResult[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TpoProfile {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @unique @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String?
  departmentScope String[]
  createdAt DateTime @default(now())
}

model Skill {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  category    String
  aliases     String[]
  students    StudentSkill[]
  roleSkills  RoleSkill[]
  jobRequirements JobRequirement[]
  demandObservations DemandObservation[]
  extractedSkills ResumeSkill[]
  gaps        SkillGap[]
  assessmentQuestions AssessmentQuestion[]
  skillGapSnapshots SkillGapSnapshot[]
  createdAt   DateTime @default(now())
}

model StudentSkill {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @db.Uuid
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId     String   @db.Uuid
  skill       Skill    @relation(fields: [skillId], references: [id])
  proficiency Int      @default(0)
  confidence  Int      @default(0)
  source      String   @default("manual")
  verified    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  @@unique([studentId, skillId])
  @@index([skillId, proficiency])
}

model Certification {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  issuer    String?
  issuedAt  DateTime?
  filePath  String?
}

model Project {
  id          String @id @default(uuid()) @db.Uuid
  studentId   String @db.Uuid
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  profile     Profile @relation(fields: [profileId], references: [id])
  profileId   String @db.Uuid
  title       String
  description String?
  githubUrl   String?
  liveUrl     String?
  privateFilePath String?
  status      ProjectStatus @default(DRAFT)
  feedback    String?
  verifiedSkills Json?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
}

model Internship {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company   String
  role      String
  months    Int
  verified  Boolean @default(false)
}

model Hackathon {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  outcome   String?
  year      Int?
}

model Resume {
  id             String @id @default(uuid()) @db.Uuid
  studentId      String @db.Uuid
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  filePath       String
  originalName   String
  mimeType       String
  extractedText  String?
  extractionStatus String @default("pending")
  skills         ResumeSkill[]
  createdAt      DateTime @default(now())
}

model ResumeSkill {
  id        String @id @default(uuid()) @db.Uuid
  resumeId  String @db.Uuid
  resume    Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skillId   String @db.Uuid
  skill     Skill @relation(fields: [skillId], references: [id])
  evidence  String?
  confidence Int @default(0)
  confirmed Boolean @default(false)
}

model MarketSource {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  providerType String
  url       String?
  isDevelopment Boolean @default(false)
  snapshots MarketSnapshot[]
}

model MarketSnapshot {
  id          String @id @default(uuid()) @db.Uuid
  sourceId    String @db.Uuid
  source      MarketSource @relation(fields: [sourceId], references: [id])
  capturedAt  DateTime @default(now())
  label       String
  metadata    Json?
  demandObservations DemandObservation[]
  roles       CareerRole[]
}

model CareerRole {
  id          String @id @default(uuid()) @db.Uuid
  marketSnapshotId String? @db.Uuid
  marketSnapshot MarketSnapshot? @relation(fields: [marketSnapshotId], references: [id])
  title       String
  slug        String @unique
  description String
  demandScore Int @default(0)
  roleSkills  RoleSkill[]
  matches     CareerRoleMatch[]
  jobs        Job[]
  createdAt   DateTime @default(now())
}

model RoleSkill {
  id        String @id @default(uuid()) @db.Uuid
  roleId    String @db.Uuid
  role      CareerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skillId   String @db.Uuid
  skill     Skill @relation(fields: [skillId], references: [id])
  required  Boolean @default(true)
  weight    Int @default(1)
  @@unique([roleId, skillId])
}

model DemandObservation {
  id          String @id @default(uuid()) @db.Uuid
  snapshotId  String @db.Uuid
  snapshot    MarketSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  skillId     String @db.Uuid
  skill       Skill @relation(fields: [skillId], references: [id])
  roleTitle   String
  demandCount Int @default(0)
  demandDelta Int @default(0)
  @@index([skillId, snapshotId])
}

model Course {
  id          String @id @default(uuid()) @db.Uuid
  title       String
  slug        String @unique
  description String
  skillIds    String[]
  level       String
  estimatedHours Int
  phases      CoursePhase[]
  progress    CourseProgress[]
  assessments Assessment[]
  createdAt   DateTime @default(now())
}

model CoursePhase {
  id        String @id @default(uuid()) @db.Uuid
  courseId  String @db.Uuid
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  resources LearningResource[]
  practiceTasks PracticeTask[]
  @@unique([courseId, position])
}

model LearningResource {
  id        String @id @default(uuid()) @db.Uuid
  phaseId   String @db.Uuid
  phase     CoursePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title     String
  url       String
  kind      String
  durationMinutes Int?
}

model PracticeTask {
  id        String @id @default(uuid()) @db.Uuid
  phaseId   String @db.Uuid
  phase     CoursePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title     String
  brief     String
  skillIds  String[]
}

model Assessment {
  id        String @id @default(uuid()) @db.Uuid
  courseId  String @db.Uuid
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]
}

model AssessmentQuestion {
  id         String @id @default(uuid()) @db.Uuid
  assessmentId String @db.Uuid
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type       AssessmentQuestionType
  prompt     String
  options    Json?
  answer     String
  explanation String?
  skillId    String? @db.Uuid
  skill      Skill? @relation(fields: [skillId], references: [id])
  difficulty String
}

model CourseProgress {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId  String @db.Uuid
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    CourseProgressStatus @default(NOT_STARTED)
  percent   Int @default(0)
  updatedAt DateTime @updatedAt
  @@unique([profileId, courseId])
}

model AssessmentAttempt {
  id          String @id @default(uuid()) @db.Uuid
  profileId   String @db.Uuid
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assessmentId String @db.Uuid
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score       Int
  answers     Json
  attemptedAt DateTime @default(now())
}

model Company {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  logoPath    String?
  website     String?
  jobs        Job[]
  createdAt   DateTime @default(now())
}

model Job {
  id          String @id @default(uuid()) @db.Uuid
  companyId   String @db.Uuid
  company     Company @relation(fields: [companyId], references: [id])
  roleId      String? @db.Uuid
  role        CareerRole? @relation(fields: [roleId], references: [id])
  title       String
  location    String
  description String
  ctc        String?
  minCgpa     Decimal? @db.Decimal(4,2)
  allowedBranches String[]
  maxBacklogs Int?
  graduationYear Int?
  deadline    DateTime
  externalUrl String
  status      JobStatus @default(PUBLISHED)
  requirements JobRequirement[]
  applications Application[]
  matches     StudentJobMatch[]
  createdAt   DateTime @default(now())
  @@index([status, deadline])
}

model JobRequirement {
  id        String @id @default(uuid()) @db.Uuid
  jobId     String @db.Uuid
  job       Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId   String @db.Uuid
  skill     Skill @relation(fields: [skillId], references: [id])
  required  Boolean @default(true)
  minimumProficiency Int @default(50)
  @@unique([jobId, skillId])
}

model Application {
  id          String @id @default(uuid()) @db.Uuid
  profileId   String @db.Uuid
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobId       String @db.Uuid
  job         Job @relation(fields: [jobId], references: [id])
  status      ApplicationStatus @default(APPLIED)
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  statusHistory ApplicationStatusHistory[]
  placementResult PlacementResult?
  @@unique([profileId, jobId])
}

model ApplicationStatusHistory {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  changedBy     String? @db.Uuid
  createdAt     DateTime @default(now())
  @@index([applicationId, createdAt])
}

model PlacementResult {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @unique @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id])
  studentId     String @db.Uuid
  student       StudentProfile @relation(fields: [studentId], references: [id])
  outcome       ApplicationStatus
  source        String
  recordedAt    DateTime @default(now())
}

model CareerRoleMatch {
  id          String @id @default(uuid()) @db.Uuid
  studentId   String @db.Uuid
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roleId      String @db.Uuid
  role        CareerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  matchScore  Int
  matchedSkills String[]
  missingSkills String[]
  explanation Json
  calculatedAt DateTime @default(now())
  @@unique([studentId, roleId])
}

model StudentJobMatch {
  id            String @id @default(uuid()) @db.Uuid
  studentId     String @db.Uuid
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  jobId         String @db.Uuid
  job           Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchScore    Int
  eligible      Boolean
  eligibilityReasons String[]
  matchedSkills String[]
  missingSkills String[]
  calculatedAt  DateTime @default(now())
  @@unique([studentId, jobId])
}

model SkillGap {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId   String @db.Uuid
  skill     Skill @relation(fields: [skillId], references: [id])
  currentProficiency Int
  targetProficiency Int
  priority  String
  source    String
  @@unique([studentId, skillId])
}

model Bootcamp {
  id          String @id @default(uuid()) @db.Uuid
  title       String
  description String
  source      BootcampSource
  status      BootcampStatus @default(DRAFT)
  targetSkillIds String[]
  enrollments BootcampEnrollment[]
  createdAt   DateTime @default(now())
}

model BootcampEnrollment {
  id        String @id @default(uuid()) @db.Uuid
  bootcampId String @db.Uuid
  bootcamp  Bootcamp @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  profileId String @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())
  @@unique([bootcampId, profileId])
}

model Poll {
  id        String @id @default(uuid()) @db.Uuid
  question  String
  active    Boolean @default(true)
  options   PollOption[]
  responses PollResponse[]
  createdAt DateTime @default(now())
}

model PollOption {
  id      String @id @default(uuid()) @db.Uuid
  pollId  String @db.Uuid
  poll    Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label   String
  value   String
  responses PollResponse[]
}

model PollResponse {
  id        String @id @default(uuid()) @db.Uuid
  pollId    String @db.Uuid
  poll      Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String @db.Uuid
  option    PollOption @relation(fields: [optionId], references: [id])
  profileId String @db.Uuid
  createdAt DateTime @default(now())
  @@unique([pollId, profileId])
}

model Notification {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([profileId, readAt, createdAt])
}

model NotificationPreference {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @unique @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  inApp     Boolean @default(true)
  email     Boolean @default(false)
}

model InstitutionalMetric {
  id          String @id @default(uuid()) @db.Uuid
  metricKey   String
  metricValue Decimal @db.Decimal(12,2)
  departmentId String? @db.Uuid
  cohortId    String? @db.Uuid
  capturedAt  DateTime @default(now())
  metadata    Json?
  @@index([metricKey, capturedAt])
}

model SkillGapSnapshot {
  id          String @id @default(uuid()) @db.Uuid
  skillId     String @db.Uuid
  skill       Skill @relation(fields: [skillId], references: [id])
  demandScore Int
  coverageScore Int
  opportunityGap Int
  department  String?
  graduationYear Int?
  capturedAt  DateTime @default(now())
}

model AuditEvent {
  id        String @id @default(uuid()) @db.Uuid
  actorId   String? @db.Uuid
  action    String
  entity    String
  entityId  String?
  payload   Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
}
